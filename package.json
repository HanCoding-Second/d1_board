{
  "name": "movie-community",
  "version": "0.1.0",
  "private": true,
  "description": "영화 커뮤니티 - Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 execute movie-community-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute movie-community-db --local --file=./seed.sql",
    "db:reset:local": "npm run db:init:local && npm run db:seed:local",
    "db:init:remote": "wrangler d1 execute movie-community-db --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.104.0"
  }
}
